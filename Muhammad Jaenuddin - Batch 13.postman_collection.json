{
  "info": {
    "_postman_id": "a0fcb74a-0b6f-45e8-876d-5f9abc163609",
    "name": "Muhammad Jaenuddin - Batch 13",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "17535504"
  },
  "item": [
    {
      "name": "Get Users",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 401\", function () {\n    pm.response.to.have.status(401);\n});\n\npm.test(\"Response body has token required message\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.message).to.eql(\"Token required!\");\n});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "{{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://belajar-bareng.onrender.com/api/users",
          "protocol": "https",
          "host": [
            "belajar-bareng",
            "onrender",
            "com"
          ],
          "path": [
            "api",
            "users"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Pre-request script should not parse response before sending"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();\nconsole.log(\"Response Login:\", res);           // cek isi response\npm.collectionVariables.set(\"token\", res.token); // simpan token\nconsole.log(\"Token tersimpan:\", res.token);    // verifikasi"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"password\": \"admin\",\n    \"username\":\"admin\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://belajar-bareng.onrender.com/api/login",
          "protocol": "https",
          "host": [
            "belajar-bareng",
            "onrender",
            "com"
          ],
          "path": [
            "api",
            "login"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": ""
    }
  ]
}